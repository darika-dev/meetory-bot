{
  "name": "events_bot",
  "version": "1.0.0",
  "main": "src/server.ts",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsc --outDir dist --noEmit false && node dist/src/server.js",
    "bot:polling": "tsc --outDir dist --noEmit false && node dist/scripts/local-polling.js",
    "db:init": "node scripts/db-init.ts",
    "db:init:production": "DOTENV_CONFIG_PATH=.env.production node scripts/db-init.ts",
    "webhook:info": "node scripts/webhook-info.ts",
    "webhook:info:production": "DOTENV_CONFIG_PATH=.env.production node scripts/webhook-info.ts",
    "webhook:set": "node scripts/set-webhook.ts",
    "webhook:set:production": "DOTENV_CONFIG_PATH=.env.production node scripts/set-webhook.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fs-extra": "^11.3.6",
    "google-calendar": "^1.3.2",
    "googleapis": "^173.0.0",
    "grammy": "^1.44.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  }
}
